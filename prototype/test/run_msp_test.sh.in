#!/bin/bash
# Generated by CMake (configure_file) - runs a prototype .msp scenario through
# rsa_mpi and lets its exit code drive the ctest PASS/FAIL result.
#
# Note: no "set -e" here - onika's own setup-env.sh contains a harmless
# "[ $ONIKA_DEBUG ] && echo ..." line that returns non-zero (ONIKA_DEBUG is
# normally unset), which set -e would treat as a fatal error while sourcing it.
source "@PROTOTYPE_BUILD_DIR@/setup-env.sh"
cd "@PROTOTYPE_BUILD_DIR@"
exec ./rsa_mpi "$1"
