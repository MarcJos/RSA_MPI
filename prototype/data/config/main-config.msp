includes:
  - rsa_mpi_default.msp
  - rsa_mpi_io.msp

input_data: nop
header: nop

dimension:
  - message: { mesg: "Please define the dimension in dimension. dimension: dim_3" }

print_parameters:
  - rsa_mpi_display_domain
  - rsa_mpi_display_grid

initialize_algo:
  - rsa_mpi_grid

naive_algorithm:
  loop: true
  name: naive_algorithm
  condition: continue_loop
  body:
    - naive_candidates
    - commit_candidates
    - paraview_details_block
    - naive_draw_continue

# overridable hook: swap this to plug in an alternative packing method later on
algorithm:
  - naive_algorithm

simulation_epilog:
  - paraview_final_block

simulation:
  - header
  - global
  - dimension
  - input_data
  - initialize_algo
  - algorithm
  - print_parameters
  - simulation_epilog
