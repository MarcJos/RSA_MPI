input_data: nop
header: nop

# internal default, needed so that the naive_algorithm loop condition has a
# value before its first iteration; overridden in place after each draw
global:
  continue_loop: true

dimension:
  - message: { mesg: "Please define the dimension in dimension. dimension: dim_3" }

print_parameters:
  - rsa_mpi_display_domain
  - rsa_mpi_display_grid

initialize_algo:
  - rsa_mpi_grid

naive_algorithm:
  loop: true
  name: naive_algorithm
  condition: continue_loop
  body:
    - naive_draw
    - naive_draw_continue

# overridable hook: swap this to plug in an alternative packing method later on
algorithm:
  - naive_algorithm

simulation:
  - header
  - global
  - dimension
  - input_data
  - initialize_algo
  - algorithm
  - print_parameters
