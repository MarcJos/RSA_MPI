dimension:
  - dim_3

input_data:
  - uniform_radius_generator:
     inf: [0,0,0]
     sup: [1,1,1]
     radius: 0.05

initialize_algo:
  - exanb_domain_init:
     domain_inf: [0,0,0]
     domain_sup: [1,1,1]
  - init_rcb_grid
  - exanb_pad_grid_ghost:
     ghost_layer: 1
  - exanb_voxel_list_init

algorithm: exanb_voxel_algorithm

global:
  paraview_details: true
  paraview_final: true

print_parameters: nop
simulation_epilog:
  - exanb_paraview_final_block
  - exanb_write_xyz
